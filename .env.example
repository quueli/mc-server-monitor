# HTTP listen address
HTTP_ADDR=:8080

# comma separated host:port list to monitor
MONITOR_SERVERS=play.hypixel.net:25565,mc.example.com:25565

# how often to re-check every server
POLL_INTERVAL=5m

# max servers pinged at the same time
POLL_CONCURRENCY=10

# per-server ping timeout
PING_TIMEOUT=10s

# status cache ttl (a repeated check inside this window is served from memory)
CACHE_TTL=2m

# drop status samples older than this
SAMPLE_RETENTION=336h

# persistence: leave DB_DSN empty to keep everything in memory.
# to use the sql store, set both and add the matching database/sql driver
# import to cmd/server/main.go (for example modernc.org/sqlite).
DB_DRIVER=
DB_DSN=

# debug | info | warn | error
LOG_LEVEL=info
